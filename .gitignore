# ============================================================
# 認証情報。**絶対にコミットしない。**
# ============================================================
# 実キーを書くファイル。テンプレートの .env.example だけを追跡する。
.env
.env.*
!.env.example
# direnv。`.env.*` では当たらないので別に弾く。
.envrc

# 鍵・証明書
*.pem
*.key
*.p12
*.pfx

# Google Cloud のサービスアカウント鍵。JSON で降ってくるので名前で弾く。
# このツールは API キーしか使わないが、同じディレクトリに置かれる事故を防ぐ。
service-account*.json
client_secret*.json
*credentials*.json
gcloud-*.json

# ============================================================
# 生成物・キャッシュ
# ============================================================
.venv/
__pycache__/
*.pyc
.mypy_cache/
.pytest_cache/
.ruff_cache/

# 書き起こしの控え。**成果物ではなく高速化のためだけのもの。**
# 消しても記事の作られ方は変わらない。中身は YouTube の字幕そのもの。
articles/.cache/

# 手元の作業メモ・チケット。**リポジトリには持ち込まない。**
.scratch/

# macOS
.DS_Store

# ============================================================
# 記事は成果物であり、同時に「処理済み」の状態でもある。
# **既定では追跡する。** 追跡したくない場合はここに articles/ を足す。
# ============================================================
