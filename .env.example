# youtube-scribe のローカル実行用テンプレート。
#   cp .env.example .env
# としてコピーし、.env 側に実際の値を書く。.env は .gitignore 済み。
#
# 読み込んで実行する:
#   set -a && source .env && set +a && uv run youtube-scribe "<再生リストのURL>" --dry-run

# --- 必須 ---
# https://console.cloud.google.com/ で YouTube Data API v3 を有効化して発行する
YOUTUBE_API_KEY=
# https://aistudio.google.com/apikey で発行する。無料枠で動く
GEMINI_API_KEY=

# --- 任意（既定値あり。詳細は README.md の環境変数一覧） ---
# GEMINI_MODEL=gemini-3.8-flash
# WHISPER_MODEL=~/.cache/whisper.cpp/ggml-large-v3.bin

# GOOGLE_API_KEY は設定しないこと。GEMINI_API_KEY と両方あると
# SDK は GOOGLE_API_KEY を優先し、警告を出す。
